#!/bin/sh
set -eu

if ! command -v pkexec >/dev/null 2>&1 || ! command -v xhost >/dev/null 2>&1; then
  zenity --error --title='Installer unavailable' --text='The disk installer is missing a required system component. Please restart Centipede from the USB and try again.' 2>/dev/null || true
  exit 1
fi

# pkexec deliberately drops the user's graphical-session environment. Grant
# root access to this local X session only for the installer lifetime.
DISPLAY_VALUE=${DISPLAY:-}
XAUTH_VALUE=${XAUTHORITY:-"${HOME:-}/.Xauthority"}
if [ -z "$DISPLAY_VALUE" ] || [ ! -r "$XAUTH_VALUE" ]; then
  zenity --error --title='Installer unavailable' --text='The graphical session is not ready. Sign in to the Centipede desktop, then open Install Centipede OS again.' 2>/dev/null || true
  exit 1
fi

xhost "+si:localuser:root" >/dev/null
cleanup() { xhost "-si:localuser:root" >/dev/null 2>&1 || true; }
trap cleanup EXIT HUP INT TERM
pkexec /usr/local/libexec/centipede-installer-root
