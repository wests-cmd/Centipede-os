[Unit]
Description=Centipede key-only headless server access
Requires=centipede-server-bootstrap.service
After=centipede-server-bootstrap.service
ConditionKernelCommandLine=centipede.server=1
ConditionPathExists=/run/centipede/server-ready

[Service]
Type=simple
ExecStart=/usr/sbin/sshd -D -e -f /etc/centipede/server-sshd.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
