[Unit]
Description=Centipede local web and API service (unprivileged)
After=network.target
RequiresMountsFor=/opt/centipede/web
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=centipede-web
Group=centipede-web
StateDirectory=centipede
StateDirectoryMode=0700
WorkingDirectory=/var/lib/centipede
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=CENTIPEDE_WEB_ROOT=/opt/centipede/web
Environment=CENTIPEDE_FILES_ROOT=/var/lib/centipede/files
Environment=CENTIPEDE_KNOWLEDGE_HOME=/var/lib/centipede/selected-knowledge
EnvironmentFile=-/etc/centipede/owner.env
ExecStart=/opt/centipede/bin/centipede-server
ReadWritePaths=/var/lib/centipede
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
