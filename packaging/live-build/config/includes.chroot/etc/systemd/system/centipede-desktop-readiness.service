[Unit]
Description=Verify Centipede desktop readiness
After=lightdm.service centipede-web.service
Wants=lightdm.service centipede-web.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/centipede-desktop-readiness.py
TimeoutStartSec=130
StandardOutput=journal+console
StandardError=journal+console
TTYPath=/dev/ttyS0

[Install]
WantedBy=graphical.target
