#!/bin/sh
set -eu
if ! getent group centipede-web >/dev/null; then
  addgroup --system centipede-web
fi
if ! id centipede-web >/dev/null 2>&1; then
  adduser --system --ingroup centipede-web --home /nonexistent --no-create-home --disabled-login centipede-web
fi
if [ -d /opt/centipede/web ]; then
  chown -R root:root /opt/centipede/web
  chmod -R go-w /opt/centipede/web
  find /opt/centipede/web -type d -exec chmod 0755 {} +
  find /opt/centipede/web -type f -exec chmod 0644 {} +
  runuser -u centipede-web -- test -r /opt/centipede/web/index.html
fi
if [ -d /opt/centipede/bin ]; then
  chown -R root:root /opt/centipede/bin
  chmod 0755 /opt/centipede/bin /opt/centipede/bin/centipede-server
fi
